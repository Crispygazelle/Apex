# Copy to /etc/apex/apex.env and chmod 600.
# These overlay config/apex.yaml via the APEX__SECTION__KEY convention.

APEX__NODE__HELMET_ID=helmet01
APEX__NODE__SENSOR_BACKEND=hardware
APEX__NODE__LOG_LEVEL=INFO

# Dashboard is useful on the bench. Turn it off on the road if you want the RAM.
# APEX__DASHBOARD__ENABLED=true

# Voice needs models in /opt/apex/models (scripts/fetch_models.sh) and the mic.
# APEX__VOICE__ENABLED=true
# APEX__SENSORS__MIC__ENABLED=true

# Status LED is Pi-only.
# APEX__SAFETY__LED__ENABLED=true

# InfluxDB. Leave the token out of git.
# APEX__STORAGE__ENABLED=true
# APEX__STORAGE__URL=http://192.168.1.10:8086
# APEX__STORAGE__TOKEN=
# APEX__STORAGE__ORG=apex
# APEX__STORAGE__BUCKET=telemetry

# SOS webhook. Empty means the alert is logged only.
# APEX__SAFETY__SOS_WEBHOOK_URL=
# APEX__SAFETY__EMERGENCY_CONTACT=
